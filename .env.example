ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$uH3y4J3qJ...

# Demo Meeting URL Placeholder
DEMO_MEETING_URL=https://zoom.us/j/DEMO-PLACEHOLDER

# Google Sheets Synchronization (Optional for offline local use)
